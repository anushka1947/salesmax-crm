# ===========================================================================
# SalesMax Backend Environment Configuration (.env.example)
# Copy this file to .env and configure with your database credentials.
# ===========================================================================

# 1. Option A: Full Connection String (Standard on Render / Neon / Supabase)
# Render automatically provides this variable in your PostgreSQL service settings.
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/salesmax

# 2. Option B: Discrete Parameters (Fallback for Local / Docker setups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=salesmax

# 3. Allowed CORS Origins (Comma-separated for multiple frontend domains)
# Example for production: https://salesmax-web.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
