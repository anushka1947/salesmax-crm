# SalesMax CRM Mobile API Configuration
# Choose the appropriate URL based on your testing environment:

# 1. Expo Web (Browser):
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# 2. Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# 3. iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# 4. Physical Mobile Device (Same Wi-Fi LAN):
# Replace with your development PC's local IPv4 address
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8000
