# ===========================================================================
# SalesMax Web CRM Environment Configuration (.env.example)
# ===========================================================================

# In Local Development:
# Set this in web/.env.local (or leave commented out to default to http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# In Production (Vercel Project Settings -> Environment Variables):
# Point this to your live Render backend URL:
# NEXT_PUBLIC_API_URL=https://your-salesmax-backend.onrender.com
